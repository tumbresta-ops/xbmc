<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.kademlia"
       name="Kademlia"
       version="1.1.1"
       provider-name="openkampus">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Browse and play files from Kademlia magnet links</summary>
    <description lang="en_GB">Browses torrent files through Kodi's magnet VFS and plays the selected video file.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
  </extension>
</addon>
